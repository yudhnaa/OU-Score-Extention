{
  "manifest_version": 3,
  "name": "OU Score Analyzer",
  "version": "1.0.0",
  "description": "Phân tích điểm sinh viên ĐH Mở TP.HCM - Tính GPA, loại bỏ môn, sắp xếp kỳ, xuất dữ liệu",
  "permissions": ["activeTab", "scripting", "storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://tienichsv.ou.edu.vn/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": ["dashboard.html", "style.css", "dashboard.js", "shared.js", "libs/chart.js", "libs/html2canvas.js"],
      "matches": ["<all_urls>"]
    }
  ]
}
